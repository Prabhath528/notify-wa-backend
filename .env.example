# ---------------------------------------------------------
# Notify WA backend - environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git.
# ---------------------------------------------------------

# PostgreSQL (local pgAdmin4 test setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=notify_wa_db

# JWT auth
SECRET_KEY=change-this-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# WhatsApp official Cloud API (leave blank while running the demo/mock mode)
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEMO_MODE=true

# PayHere payment gateway (sandbox values shown - replace with real merchant details)
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_MODE=sandbox
PAYHERE_RETURN_URL=http://localhost:8000/api/subscription/payhere/return
PAYHERE_CANCEL_URL=http://localhost:8000/api/subscription/payhere/cancel
PAYHERE_NOTIFY_URL=http://localhost:8000/api/subscription/payhere/notify

# Bank transfer details shown to users as a fallback payment option
BANK_NAME=Commercial Bank of Ceylon PLC
BANK_ACCOUNT_NAME=Pixel Forge Studio
BANK_ACCOUNT_NUMBER=0000000000
BANK_BRANCH=Negombo

# Plan limits
FREE_PLAN_MESSAGE_LIMIT=50
PRO_PLAN_MESSAGE_LIMIT=500
PRO_PLAN_PRICE_LKR=659
UNLIMITED_PLAN_PRICE_LKR=1499

# Developer / studio info shown in the app
DEVELOPER_INFO_URL=http://pixelforgestudioprabhath.netlify.app/
